{
  "seed": 42,
  "environment": {
    "sizes": [
      5,
      7
    ],
    "max_size": 7,
    "wall_probability": 0.28,
    "mud_probability": 0.3,
    "floor_cost": 1.0,
    "mud_cost": 4.0,
    "collision_cost": 2.0,
    "cost_scale": 0.1,
    "goal_reward": 5.0,
    "max_steps": 64,
    "minimum_cost_gap": 2.0,
    "generation_attempts": 10000
  },
  "model": {
    "layers": 4,
    "width": 128,
    "heads": 4,
    "ff_multiplier": 4
  },
  "data": {
    "train_maps": 2000,
    "validation_maps": 24,
    "test_maps": 48
  },
  "pretrain": {
    "steps": 1500,
    "batch_size": 64,
    "learning_rate": 0.0003,
    "cost_loss_coefficient": 1.0
  },
  "sft": {
    "steps": 4000,
    "batch_size": 64,
    "learning_rate": 0.0002,
    "correction_every": 100,
    "correction_maps": 32,
    "correction_weight": 4.0
  },
  "training": {
    "log_every": 50,
    "checkpoint_every": 250,
    "gradient_clip": 1.0,
    "weight_decay": 0.01
  },
  "evaluation": {
    "world_samples": 512,
    "batch_size": 128
  },
  "display": {
    "animation_delay": 0.2
  },
  "ppo": {
    "steps": 250,
    "num_envs": 16,
    "learning_rate": 1e-05,
    "epochs": 2,
    "minibatch": 128,
    "clip_epsilon": 0.2,
    "value_coefficient": 0.5,
    "entropy_coefficient": 0.01,
    "gamma": 1.0,
    "gae_lambda": 0.95,
    "target_kl": 0.02,
    "critic_learning_rate": 0.0003,
    "value_warmup_epochs": 10,
    "reference_kl_coefficient": 0.05,
    "potential_scale": 0.1
  }
}
